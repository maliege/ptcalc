<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7c2f7c1e-5b0e-4d8a-9a3b-6f1e2d4c8b90</UserSecretsId>
    <!--
      RootNamespace ve AssemblyName açıkça yazılır: IStringLocalizer kaynak adını derleme adından türetir
      (PTCalc.Resources.SharedResource, büyük/küçük harfe duyarlı). Komut satırında proje yolu farklı
      harflerle yazılırsa türetilen ad değişir ve İngilizce resx bulunmaz.
    -->
    <RootNamespace>PTCalc</RootNamespace>
    <AssemblyName>PTCalc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ChartJs.Blazor.Fork" Version="2.0.2" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- ChartJs.Blazor.Fork eski Newtonsoft.Json 12.0.3 getirir (NU1903); güncel sürüme yükseltilir. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- MailKit → MimeKit, System.Security.Cryptography.Pkcs 10.0.0 getirir (NU1902/NU1903: GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7, 13.10.2026); MimeKit 4.18.1 de aynı. Düzeltilmiş sürüme sabitlenir. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTCalc.Core\PTCalc.Core.csproj" />
  </ItemGroup>

</Project>
